{
  "name": "control-plane-api",
  "sourceRoot": "packages/control-plane-api/src",
  "projectType": "application",
  "implicitDependencies": [
    "guardrail-policy",
    "workspace-registry",
    "indicators",
    "workload-identity",
    "evidence-store"
  ],
  "tags": ["scope:api", "criticality:high"],
  "targets": {
    "serve": { "command": "node packages/control-plane-api/src/main.mjs" },
    "test": { "command": "node --test packages/control-plane-api/src/*.test.mjs" },
    "integration": {
      "command": "node --test packages/control-plane-api/src/*.integration.mjs",
      "cache": false
    },
    "typecheck": {
      "command": "for f in packages/control-plane-api/src/*.mjs; do node --check \"$f\" || exit 1; done"
    },
    "build": {
      "command": "for f in packages/control-plane-api/src/*.mjs; do node --check \"$f\" || exit 1; done"
    }
  }
}
