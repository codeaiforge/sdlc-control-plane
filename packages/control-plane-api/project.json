{
  "name": "control-plane-api",
  "sourceRoot": "packages/control-plane-api/src",
  "projectType": "application",
  "implicitDependencies": ["guardrail-policy", "workspace-registry", "indicators"],
  "tags": ["scope:api", "criticality:high"],
  "targets": {
    "serve": { "command": "node packages/control-plane-api/src/main.mjs" },
    "test": { "command": "node --test packages/control-plane-api/src/*.test.mjs" },
    "typecheck": {
      "command": "node --check packages/control-plane-api/src/main.mjs && node --check packages/control-plane-api/src/openapi-schema.mjs && node --check packages/control-plane-api/src/evidence-store.mjs && node --check packages/control-plane-api/src/store-conformance.mjs"
    },
    "build": {
      "command": "node --check packages/control-plane-api/src/main.mjs && node --check packages/control-plane-api/src/openapi-schema.mjs && node --check packages/control-plane-api/src/evidence-store.mjs && node --check packages/control-plane-api/src/store-conformance.mjs"
    }
  }
}
